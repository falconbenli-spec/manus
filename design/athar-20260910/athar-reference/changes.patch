+}
+.portal-hero .relative > div {
+  min-width: 0;
+}
+.portal-hero h1 {
+  line-height: 1.65;
+  overflow-wrap: anywhere;
+}
+.portal-hero button {
+  min-height: 44px;
+  min-width: 44px;
+}
+@media (max-width: 440px) {
+  .portal-hero > .relative {
+    flex-wrap: wrap;
+  }
+  .portal-hero .people-portal-art {
+    inset-inline-start: 25%;
+  }
+}
+body.athar-portal::before,
+body.athar-portal::after {
+  display: none !important;
+}
+body.athar-portal .notif-panel:not(.open) {
+  display: none;
+}
+body.athar-portal .dash-widget,
+body.athar-portal .quick-actions {
+  background: var(--people-panel);
+  border: 1px solid var(--people-line);
+  box-shadow: none;
+  transform: none;
+}
+body.athar-portal .dash-widget:before {
+  display: none;
+}
+body.athar-portal .dash-widget-value {
+  color: var(--people-ink);
+}
+body.athar-portal .dash-widget-icon {
+  background: var(--people-mint);
+  transform: none;
+}
+body.athar-portal .dash-widget:hover {
+  transform: none;
+  box-shadow: none;
+}
+body.athar-portal .portal-name {
+  white-space: normal;
+  overflow: visible;
+  max-width: none;
+}
+body.athar-portal .quick-action-btn {
+  box-shadow: none;
+  border-color: var(--people-line);
+}
+@media (max-width: 767px) {
+  body.athar-portal .portal-header {
+    display: flex;
+    flex-direction: column;
+    align-items: stretch;
+  }
+  body.athar-portal .portal-header-actions {
+    position: static;
+    order: 2;
+    width: auto;
+    margin: 0;
+    justify-content: flex-end;
